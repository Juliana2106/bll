{
	"name": "BLL_Reto1",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Obtener Parametros",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@concat(\n'SELECT ot.order_id, ot.item_id, ot.product_id, ot.quantity, ot.list_price, ot.discount, o.order_date\nFROM BikeStores.sales.order_items ot\nINNER JOIN BikeStores.sales.orders o ON o.order_id = ot.order_id\nWHERE YEAR(o.order_date) = ''',\nsubstring(activity('Obtener Parametros').output.firstRow.FechaProceso, 0, 4),\n''' AND MONTH(o.order_date) = ''',\nsubstring(activity('Obtener Parametros').output.firstRow.FechaProceso, 5, 2),\n''''\n)",
							"type": "Expression"
						},
						"isolationLevel": "ReadCommitted",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"dataIntegrationUnits": 4,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "Table_Order_Items",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "Parquet_Order_Items",
						"type": "DatasetReference",
						"parameters": {
							"pr_Fecha_Proceso": {
								"value": "@activity('Obtener Parametros').output.firstRow.FechaProceso",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Obtener Parametros",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "\nselect Valor as FechaProceso\nfrom BikeStores.dbo.Parametros\nwhere Codigo=1",
						"isolationLevel": "ReadCommitted",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "Table_Parameters",
						"type": "DatasetReference"
					}
				}
			}
		],
		"annotations": []
	}
}